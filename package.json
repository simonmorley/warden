{
  "name": "warden",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Phishing triage where the AI has to earn the right to act.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @warden/worker",
    "dev:host": "npm run dev -w @warden/worker -- --ip 0.0.0.0",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "deploy": "npm run deploy -w @warden/worker"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
